.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# 패키징 및 빌드 산출물
build/
dist/
*.egg-info/
pip-wheel-metadata/

# 환경 변수 및 로컬 설정
.env
.env.*
!.env.example

# 로그 및 임시 파일
*.log
*.tmp
*.temp
*.bak

# IDE 및 운영체제 파일
.idea/
.vscode/
.vs/
